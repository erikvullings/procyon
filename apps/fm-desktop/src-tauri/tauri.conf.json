{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "nl.erikvullings.procyon",
  "productName": "Procyon",
  "mainBinaryName": "Procyon",
  "build": {
    "devUrl": "http://127.0.0.1:5181",
    "frontendDist": "../../../frontend/dist",
    "beforeDevCommand": "pnpm exec cross-env VITE_RUNTIME=tauri pnpm --dir ../../frontend exec vite --port 5181",
    "beforeBuildCommand": "pnpm exec cross-env VITE_RUNTIME=tauri pnpm --dir ../../frontend build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Procyon",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#ffffff",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../plugins": "plugins"
    }
  }
}
