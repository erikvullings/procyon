<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS deduplicates launches of the same bundle by default: clicking the Dock icon (or
	     double-clicking in Finder) while an instance is already running just activates that
	     instance instead of starting a new process. Setting this to false opts back into the
	     ability to open a second window/instance from the Dock, matching typical Mac app
	     behaviour. Tauri merges this file into the generated Info.plist (see
	     ../../../Cargo.toml's `info_plist` doc comment / tauri-utils' BundleConfig). -->
	<key>LSMultipleInstancesProhibited</key>
	<false/>
	<!-- Shown when macOS asks to let Procyon control Finder. Used only to copy files that Finder
	     may read but Procyon may not (for example files copied out of a Remote Desktop session
	     into another app's protected container) when they are pasted. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Procyon asks Finder to copy files that only Finder is allowed to read, such as files copied from a Remote Desktop session.</string>
</dict>
</plist>
