{
  "name": "@fm/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mithril frontend for the dual-pane file manager, shared by the Axum and Tauri hosts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:directory-table": "vitest run src/features/directory-table/directory-table.benchmark.test.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@lezer/highlight": "1.2.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "3.4.14",
    "exifr": "7.1.3",
    "meiosis-setup": "^6.2.3",
    "mithril": "^2.3.8",
    "mithril-materialized": "^3.17.9",
    "pdfjs-dist": "6.2.108",
    "slimdown-js": "1.5.0",
    "translate.js": "^1.3.2"
  },
  "devDependencies": {
    "@mithril-inspector/vite": "0.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/mithril": "^2.2.9",
    "@types/node": "^26.4.0",
    "axe-core": "^4.13.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "orval": "^8.26.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
