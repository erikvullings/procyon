From 6a02ad9b9748a4ccc93deb30bf3044d4c3c32142 Mon Sep 17 00:00:00 2001
From: Erik Vullings <noreply@example.invalid>
Date: Sat, 14 Nov 2026 11:28:41 +0100
Subject: [PATCH] feat(embeddinggemma2): encode ids with externally computed
 rows

Adds encode_rows_at_widths and encode_rows_at_widths_metal: ids whose listed
positions carry rows computed outside the model (soft tokens of another
modality) are encoded through the same host or GPU-resident forward pass as
text and image parts.
---
 crates/models/embeddinggemma2/src/model.rs    | 74 +++++++++++++++++++
 .../models/embeddinggemma2/src/model/tests.rs | 48 ++++++++++++
 2 files changed, 122 insertions(+)

diff --git a/crates/models/embeddinggemma2/src/model.rs b/crates/models/embeddinggemma2/src/model.rs
index 4b79f521a4..aad0e88586 100644
--- a/crates/models/embeddinggemma2/src/model.rs
+++ b/crates/models/embeddinggemma2/src/model.rs
@@ -1433,6 +1433,80 @@ impl EmbeddingGemma2Model {
         ))
     }
 
+    /// One embedding per entry of `widths` for `ids` in which the listed positions carry rows
+    /// computed outside this model, such as the bridged soft tokens of another modality.
+    ///
+    /// The id at each listed position is only a placeholder: it is read as padding when the
+    /// hard-token embeddings and the per-layer signal are gathered, and the row replaces it
+    /// unscaled, as image rows are in [`EmbeddingGemma2Model::encode_parts_at_widths`]. `rows`
+    /// must be strictly increasing by position, inside `ids`, and each row `hidden_size` long
+    /// and finite. The token limit is not applied; the sequence runs as given.
+    /// `should_cancel` is polled before the encoder and between layers.
+    pub fn encode_rows_at_widths(
+        &self,
+        ids: &[u32],
+        rows: &[(usize, &[f32])],
+        widths: &[usize],
+        should_cancel: &mut dyn FnMut() -> bool,
+    ) -> Result<Vec<Vec<f32>>, InferenceError> {
+        self.check_widths(widths)?;
+        let combined = self.combine_external_rows(ids, rows)?;
+        let mut hidden = combined.clone();
+        self.run_text_encoder(&mut hidden, &combined, ids.len(), should_cancel)?;
+        let states = self.project_states(&hidden, ids.len())?;
+        self.pool_widths(&states, ids.len(), widths)
+    }
+
+    /// As [`EmbeddingGemma2Model::encode_rows_at_widths`], with the forward pass on the GPU
+    /// through `state`, which must have been built from this model.
+    #[cfg(all(target_os = "macos", feature = "metal-gpu"))]
+    pub fn encode_rows_at_widths_metal(
+        &self,
+        state: &mut MetalEmbeddingGemma2State,
+        ids: &[u32],
+        rows: &[(usize, &[f32])],
+        widths: &[usize],
+    ) -> Result<Vec<Vec<f32>>, InferenceError> {
+        self.check_widths(widths)?;
+        state.check_model(self)?;
+        let combined = self.combine_external_rows(ids, rows)?;
+        let states = state.forward(&combined, ids.len())?;
+        self.pool_widths(&states, ids.len(), widths)
+    }
+
+    /// Hard-token rows with `rows` scattered over their placeholder positions.
+    fn combine_external_rows(
+        &self,
+        ids: &[u32],
+        rows: &[(usize, &[f32])],
+    ) -> Result<Vec<f32>, InferenceError> {
+        let hidden = self.cfg.hidden_size;
+        let mut gather = ids.to_vec();
+        let mut slots = Vec::with_capacity(rows.len());
+        let mut values = Vec::with_capacity(rows.len() * hidden);
+        for &(position, row) in rows {
+            if position >= ids.len() {
+                return Err(InferenceError::InvalidInput(format!(
+                    "row position {position} is outside a sequence of {} tokens",
+                    ids.len()
+                )));
+            }
+            if row.len() != hidden || row.iter().any(|value| !value.is_finite()) {
+                return Err(InferenceError::InvalidInput(format!(
+                    "row at position {position} must hold {hidden} finite values"
+                )));
+            }
+            gather[position] = 0;
+            slots.push(position);
+            values.extend_from_slice(row);
+        }
+        let mut combined = self.scaled_embeddings(&gather)?;
+        if !slots.is_empty() {
+            scatter_rows(&slots, &values, hidden, &mut combined)?;
+        }
+        Ok(combined)
+    }
+
     /// Per-token states after the final norm and the `hidden -> embedding_dim` projection,
     /// row-major `[ids.len(), embedding_dim]`.
     pub fn token_states(&self, ids: &[u32]) -> Result<Vec<f32>, InferenceError> {
diff --git a/crates/models/embeddinggemma2/src/model/tests.rs b/crates/models/embeddinggemma2/src/model/tests.rs
index da5d9368aa..083709c3a7 100644
--- a/crates/models/embeddinggemma2/src/model/tests.rs
+++ b/crates/models/embeddinggemma2/src/model/tests.rs
@@ -2030,3 +2030,51 @@ mod layer_scratch_tests {
         println!("GEMMA_SCRATCH_ABSOLUTE_PLACEMENT_COMPLETE");
     }
 }
+
+#[test]
+fn external_rows_equal_the_scaled_token_rows_they_replace() {
+    let fx = fixture();
+    let ids = [3u32, 1, 4, 1, 5];
+    let direct = fx.model.encode_ids_at_widths(&ids, &[8, 4]).unwrap();
+    let scaled = fx.model.scaled_embeddings(&ids).unwrap();
+    let hidden = fx.model.config().hidden_size;
+    let rows: Vec<(usize, &[f32])> = [1usize, 3]
+        .iter()
+        .map(|&p| (p, &scaled[p * hidden..(p + 1) * hidden]))
+        .collect();
+    // The placeholder ids differ from the originals, so only the rows can restore the result.
+    let mut placeholder_ids = ids;
+    placeholder_ids[1] = 2;
+    placeholder_ids[3] = 2;
+    let mut cancelled = || false;
+    let via_rows = fx
+        .model
+        .encode_rows_at_widths(&placeholder_ids, &rows, &[8, 4], &mut cancelled)
+        .unwrap();
+    for (a, b) in direct.iter().flatten().zip(via_rows.iter().flatten()) {
+        assert!((a - b).abs() < 1e-5, "{a} vs {b}");
+    }
+}
+
+#[test]
+fn external_rows_reject_bad_positions_and_shapes() {
+    let fx = fixture();
+    let ids = [3u32, 1, 4];
+    let hidden = fx.model.config().hidden_size;
+    let row = vec![0.5f32; hidden];
+    let short = vec![0.5f32; hidden - 1];
+    let nan = vec![f32::NAN; hidden];
+    let mut cancelled = || false;
+    for rows in [
+        vec![(3usize, row.as_slice())],
+        vec![(1, short.as_slice())],
+        vec![(1, nan.as_slice())],
+        vec![(2, row.as_slice()), (1, row.as_slice())],
+    ] {
+        assert!(
+            fx.model
+                .encode_rows_at_widths(&ids, &rows, &[8], &mut cancelled)
+                .is_err()
+        );
+    }
+}
