{
  "name": "fm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "dev:mock": "cross-env VITE_RUNTIME=mock pnpm --dir frontend dev",
    "dev:http": "cross-env VITE_RUNTIME=http pnpm --dir frontend dev",
    "dev:server": "cross-env FM_SERVER_PORT=8787 cargo watch -w apps/fm-server -w crates -w Cargo.toml -w Cargo.lock -x 'run -p fm-server -- --dev-mode-auth-disabled'",
    "dev:server:no-watch": "cross-env FM_SERVER_PORT=8787 cargo run -p fm-server -- --dev-mode-auth-disabled",
    "dev:tauri": "cd apps/fm-desktop/src-tauri && pnpm exec cross-env PROCYON_SEMANTIC_COMPONENTS=mock pnpm exec tauri dev",
    "dev:tauri:semantic": "node scripts/dev-tauri-semantic.mjs",
    "dev:tauri:semantic:ocr": "node scripts/dev-tauri-semantic.mjs --ocr",
    "semantic:bundle:dev": "node scripts/build-semantic-developer-bundle.mjs",
    "semantic:bundle:production": "node scripts/build-semantic-production-bundle.mjs",
    "semantic:catalog": "node scripts/semantic-production-catalog.mjs",
    "semantic:evaluation:check": "node scripts/check-semantic-release-preconditions.mjs",
    "semantic:qualification:check": "node scripts/check-semantic-qualification-workflow.mjs",
    "semantic:model:fetch": "node scripts/fetch-semantic-model.mjs",
    "semantic:model:verify": "node scripts/verify-semantic-model.mjs",
    "semantic:onnx:prepare": "node scripts/onnx-runtime-qualification.mjs prepare",
    "semantic:zvec:prepare": "node scripts/zvec-runtime-qualification.mjs prepare",
    "test": "pnpm run test:rust && pnpm run test:frontend && pnpm run test:scripts",
    "test:rust": "cargo nextest run --workspace && cargo test --doc --workspace",
    "test:frontend": "pnpm --dir frontend test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "pnpm run lint:rust && pnpm run lint:frontend",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "lint:frontend": "biome check .",
    "api:export": "node scripts/export-openapi.mjs",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "pnpm run api:export && pnpm run api:generate && git diff --exit-code",
    "build": "pnpm run build:rust && pnpm run build:frontend",
    "build:rust": "cargo build --workspace --release",
    "build:frontend": "pnpm --dir frontend build",
    "build:tauri": "node scripts/build-tauri.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tauri-apps/cli": "^2.11.4",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.1"
  }
}
