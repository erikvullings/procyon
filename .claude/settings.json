{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c 'if ((.tool_input.command // \"\") | test(\"git\\\\s+(commit|push)\")) then {hookSpecificOutput:{hookEventName:\"PreToolUse\",updatedInput:(.tool_input + {timeout:900000})}} else {} end'"
          }
        ]
      }
    ]
  }
}
